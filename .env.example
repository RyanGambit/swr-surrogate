# ─── Server-side (Vercel environment variable) ───────────────────────────
# Set ANTHROPIC_API_KEY in the Vercel dashboard under Settings > Environment Variables.
# This key is NEVER exposed to the browser.
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Client-side (optional) ──────────────────────────────────────────────
# Override the proxy endpoint URL (defaults to /api/chat)
# VITE_CLAUDE_API_URL=/api/chat
